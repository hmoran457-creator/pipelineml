MODELO_ENTRENADO=/app/assets/modelo_entrenado.pkl
OUTPUT_LOG=/app/logs/output.txt
ERROR_LOG=/app/logs/errors.txt

# Base Chinook (Supabase - Transaction pooler)
# El usuario es postgres.<project-ref> y el host depende de la region del proyecto.
SUPABASE_USER=postgres.tu_project_ref
SUPABASE_HOST=aws-0-us-west-2.pooler.supabase.com
SUPABASE_PORT=6543
SUPABASE_DBNAME=postgres
SUPABASE_PASSWORD=tu_password
